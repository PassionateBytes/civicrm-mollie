<?xml version="1.0"?>
<extension key="nl.stichtinggast.mollie" type="module">
  <file>mollie</file>
  <name>Mollie Payment Processor</name>
  <description>Payment processor for Mollie supporting one-off and recurring donations via the Mollie PHP SDK.</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Stichting GAST</author>
    <email>ict@stichtinggast.nl</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://www.stichtinggast.nl</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <tags>
    <tag>comp:CiviContribute</tag>
    <tag>topic:payment-processor</tag>
  </tags>
  <releaseDate>2026-02-28</releaseDate>
  <version>1.0.0-dev</version>
  <develStage>alpha</develStage>
  <compatibility>
    <ver>6.0</ver>
  </compatibility>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <civix>
    <namespace>CRM/Mollie</namespace>
    <format>25.10.2</format>
  </civix>
  <upgrader>CiviMix\Schema\Mollie\AutomaticUpgrader</upgrader>
  <mixins>
    <mixin>entity-types-php@2.0.0</mixin>
    <mixin>mgd-php@2.0.0</mixin>
    <mixin>setting-php@1.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>smarty@1.0.3</mixin>
  </mixins>
</extension>
